# FinePrint configuration. Copy to .env and fill in.

# Your Groq API key.
GROQ_API_KEY=

# A chat model available on Groq, e.g. llama-3.3-70b-versatile
# Never hardcoded in code - the app reads it only from here.
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Maximum number of parallel LLM calls.
GROQ_CONCURRENCY=1

# 1 = replay recorded runs from demo_cache/ and make no API calls.
FINEPRINT_DEMO=0
